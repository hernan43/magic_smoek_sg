json.body do
    json.current_user do
        json.id current_user.id
        json.first_name current_user.first_name
        json.last_name current_user.last_name
        json.email current_user.email

        json.new_project_path new_project_path

        json.projects do
            json.array! current_user.projects do |project|
                json.id project.id
                json.name project.name
                json.description project.description.truncate(128) # don't need the whole f'n show
                json.is_public project.is_public
                json.created_at project.created_at
                json.updated_at project.updated_at
                json.path project_path(project)
            end
        end

    end
end